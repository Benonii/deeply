{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "convex/**",
      "scripts/**",
      "*.ts",
      "!convex/_generated",
      "!src/courses/convex/code",
      "!src/farm.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": { "quoteStyle": "single" }
  },
  "json": {
    "formatter": { "trailingCommas": "none" }
  },
  "linter": {
    "rules": { "recommended": true }
  },
  "overrides": [
    {
      "includes": ["src/lib/analytics.ts"],
      "linter": { "rules": { "complexity": { "noArguments": "off" } } }
    }
  ],
  "assist": { "enabled": false }
}
