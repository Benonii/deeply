{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["./reports"]
}
