{
  "name": "deeply",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "farm dev",
    "dev:desktop": "farm dev --desktop",
    "build": "farm build",
    "build:desktop": "farm build --desktop",
    "convex": "convex dev",
    "typecheck": "farm generate && tsc --noEmit -p . && tsc --noEmit -p convex",
    "verify-code": "node --experimental-strip-types --no-warnings scripts/verify-code.mjs ${SRC_REF:-../src-ref}",
    "fetch-sources": "sh scripts/fetch-sources.sh",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "node .farm/.output/server/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.109",
    "@ai-sdk/openai": "4.0.124",
    "@convex-dev/better-auth": "0.13.1",
    "@convex-dev/polar": "0.9.3",
    "@convex-dev/rate-limiter": "0.4.3",
    "@farm.js/better-auth": "0.1.87",
    "@farm.js/convex": "file:vendor/farm.js-convex-0.1.0-beta.0-9c47795.tgz",
    "@farm.js/core": "0.1.87",
    "@paper-design/shaders-react": "^0.0.82",
    "@polar-sh/checkout": "^0.4.3",
    "@polar-sh/sdk": "^0.49.0",
    "ai": "7.0.182",
    "better-auth": "1.7.28",
    "convex": "^1.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@farm.js/cli": "0.1.87",
    "@farm.js/desktop": "0.1.0-beta.8",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "electrobun": "2.0.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benonii/deeply.git"
  },
  "overrides": {
    "@farm.js/convex": {
      "@farm.js/core": "$@farm.js/core",
      "@farm.js/integration-utils": "0.1.87"
    }
  }
}
